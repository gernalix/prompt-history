[Unit]
Description=Sync lightweight derived prompt history evidence

[Service]
Type=oneshot
WorkingDirectory=%h/projects/prompt-history
ExecStartPre=/usr/bin/mkdir -p %h/.local/state/prompt-history
ExecStart=/usr/bin/flock -w 120 %h/.local/state/prompt-history/sync.lock /usr/bin/python3 -m prompt_history.cli sync --db %h/.local/share/prompt-history/prompt_history.sqlite --roadmap %h/projects/codex-roadmap/roadmap.sqlite --codex-usage %h/projects/codex-usage --chatgpt-exporter %h/Documents/ChatGPT --switcher %h/.local/state/chrome-codex-switcher/state.sqlite3
